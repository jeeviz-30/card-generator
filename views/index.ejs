<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile Card Generator | Node.js Server App</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <%- include('components/navbar', { activePage: 'home' }) %>

  <main class="main-content">
    


    <!-- Generator Workspace: Form + Card Preview -->
    <div class="dashboard-grid">
      
      <!-- Form Panel -->
      <div class="panel">
        <div class="panel-header">
          <h2 class="panel-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            1. User Details Form
          </h2>
          <span style="font-size: 0.8rem; color: var(--text-dim);">Step 1 & 2</span>
        </div>

        <% if (locals.error) { %>
          <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.875rem;">
            ⚠️ <%= error %>
          </div>
        <% } %>

        <form id="profileForm" action="/api/profiles" method="POST">
          
          <div class="form-group">
            <label class="form-label" for="fullName">Full Name <span class="required">*</span></label>
            <input type="text" id="fullName" name="full_name" class="form-input" placeholder="e.g. Alex Morgan" required value="Alex Morgan">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="jobTitle">Job Title / Role <span class="required">*</span></label>
              <input type="text" id="jobTitle" name="job_title" class="form-input" placeholder="e.g. Senior Backend Architect" required value="Senior Backend Architect">
            </div>

            <div class="form-group">
              <label class="form-label" for="themeStyle">Card Theme Style</label>
              <select id="themeStyle" name="theme_style" class="form-select">
                <option value="dark-purple" selected>🔮 Dark Purple (Default)</option>
                <option value="cyberpunk">⚡ Cyberpunk Neon</option>
                <option value="aurora">🌌 Aurora Violet</option>
                <option value="emerald">🌲 Emerald Pro</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="bio">Short Bio</label>
            <textarea id="bio" name="bio" class="form-textarea" placeholder="Write a short summary about yourself...">Full-stack software engineer with 5+ years of experience building Node.js applications, microservices, and modern UI interfaces.</textarea>
            <div class="input-hint">Server will format and sanitize bio strings automatically.</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="skills">Skills & Expertise (Comma-separated)</label>
            <input type="text" id="skills" name="skills" class="form-input" placeholder="Node.js, Express, SQLite, TypeScript, React, Docker" value="Node.js, Express, SQLite, REST API, Docker">
            <div class="input-hint">Parsed into dynamic HTML pill badges on the server.</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="avatarUrl">Avatar Image URL (Optional)</label>
            <input type="url" id="avatarUrl" name="avatar_url" class="form-input" placeholder="https://example.com/avatar.jpg">
            
            <!-- Quick Preset Avatars -->
            <div class="input-hint" style="margin-top: 0.5rem;">Or pick a preset avatar:</div>
            <div class="avatar-presets">
              <div class="preset-avatar-option" data-avatar="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=250&q=80">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=250&q=80" alt="Avatar 1">
              </div>
              <div class="preset-avatar-option" data-avatar="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=250&q=80">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=250&q=80" alt="Avatar 2">
              </div>
              <div class="preset-avatar-option" data-avatar="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=250&q=80">
                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=250&q=80" alt="Avatar 3">
              </div>
              <div class="preset-avatar-option" data-avatar="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=250&q=80">
                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=250&q=80" alt="Avatar 4">
              </div>
            </div>
          </div>

          <div style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
            <h4 style="font-size: 0.9rem; color: var(--text-main); margin-bottom: 0.75rem;">Social & Web Links</h4>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="githubUrl">GitHub</label>
                <input type="text" id="githubUrl" name="github_url" class="form-input" placeholder="username or link" value="alexmorgan">
              </div>
              <div class="form-group">
                <label class="form-label" for="linkedinUrl">LinkedIn</label>
                <input type="text" id="linkedinUrl" name="linkedin_url" class="form-input" placeholder="username or link" value="alexmorgan-dev">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="twitterUrl">Twitter / X</label>
                <input type="text" id="twitterUrl" name="twitter_url" class="form-input" placeholder="@handle" value="@alexmorgan_dev">
              </div>
              <div class="form-group">
                <label class="form-label" for="portfolioUrl">Portfolio / Website</label>
                <input type="text" id="portfolioUrl" name="portfolio_url" class="form-input" placeholder="alexmorgan.dev" value="alexmorgan.dev">
              </div>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary btn-full" style="padding: 0.9rem 1.5rem; font-size: 1rem;">
              🚀 Submit Task & Generate Card &rarr;
            </button>
          </div>

        </form>
      </div>

      <!-- Preview Panel -->
      <div>
        <div class="panel">
          <div class="panel-header">
            <h2 class="panel-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              2. Dynamic Server HTML Card Preview
            </h2>
            <span style="font-size: 0.8rem; color: var(--text-dim);">Step 3</span>
          </div>
          
          <div id="cardPreviewContainer">
            <!-- Dynamic Preview Script inserts interactive card here -->
          </div>
        </div>

        <!-- Saved Profiles Showcase -->
        <% if (profiles && profiles.length > 0) { %>
          <div class="panel" style="margin-top: 1.5rem;">
            <div class="panel-header">
              <h3 class="panel-title" style="font-size: 1.1rem;">
                💾 Stored Database Profiles (<%= profiles.length %>)
              </h3>
              <a href="/gallery" class="view-link">View All &rarr;</a>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% profiles.slice(0, 3).forEach(p => { %>
                <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(12, 9, 21, 0.5); padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <img src="<%= p.avatar_url || 'https://api.dicebear.com/7.x/identicon/svg?seed=' + p.slug %>" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" alt="<%= p.full_name %>">
                    <div>
                      <div style="font-weight: 600; font-size: 0.9rem;"><%= p.full_name %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= p.job_title %></div>
                    </div>
                  </div>
                  <a href="/profile/<%= p.slug %>" class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;">
                    View &rarr;
                  </a>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

      </div>

    </div>

  </main>

  <%- include('components/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/cardExport.js"></script>
</body>
</html>
